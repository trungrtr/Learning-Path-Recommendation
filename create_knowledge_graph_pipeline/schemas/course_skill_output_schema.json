{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haui.local/schemas/course_skill_output_schema.json",
  "title": "CourseSkillResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "calibration_status", "limitations", "course_id", "matched_skills"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "course_skill_output"},
    "calibration_status": {"enum": ["experimental", "calibrated"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "course_id": {"type": "string", "minLength": 1},
    "course_code": {"type": ["string", "null"]},
    "internal_course_code": {"type": ["string", "null"]},
    "matched_skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/matchedSkill"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_type", "quote"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "unit_type": {"enum": ["name", "description", "clo", "chapter", "lesson"]},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "matchedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "skill_uri",
        "skill_label",
        "relation_type",
        "retrieval_score",
        "rerank_score",
        "validation_confidence",
        "evidence"
      ],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "skill_uri": {"type": "string", "minLength": 1},
        "skill_label": {"type": "string", "minLength": 1},
        "skill_description": {"type": ["string", "null"]},
        "relation_type": {"enum": ["teaches", "supports"]},
        "retrieval_score": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "rerank_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "validation_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
